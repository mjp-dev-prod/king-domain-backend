// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WaitlistRole {
  talent
  client
}

model WaitlistEntry {
  id         String       @id @default(uuid())
  email      String       @unique
  role       WaitlistRole @default(talent)
  categories String[]     @default([])
  note       String?
  joinedAt   DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("waitlist_entries")
}

// ── Admin access ─────────────────────────────────────────

enum AdminRole {
  owner // can invite and revoke other admins
  admin // read-only access to the dashboard
}

enum AdminStatus {
  invited // invite issued, password not yet set
  active
  revoked
}

model AdminUser {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String?
  role         AdminRole   @default(admin)
  status       AdminStatus @default(invited)
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tokens   AdminToken[]
  sessions AdminSession[]

  decisionsCreated     Decision[]             @relation("DecisionsCreated")
  decisionsClosed      Decision[]             @relation("DecisionsClosed")
  decisionStances      DecisionStance[]
  decisionComments     DecisionComment[]
  pendingNotifications PendingNotification[]

  @@map("admin_users")
}

enum AdminTokenKind {
  invite
  password_reset
}

/// Single-use, expiring links. Only the SHA-256 hash of the token is stored,
/// so a database leak never yields a usable link.
model AdminToken {
  id        String         @id @default(uuid())
  userId    String
  tokenHash String         @unique
  kind      AdminTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_tokens")
}

/// Server-side sessions so access can be revoked immediately, rather than
/// waiting for a self-contained token to expire.
model AdminSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_sessions")
}

// ── Shareholder decisions ────────────────────────────────

enum DecisionStatus {
  open
  closed
}

enum Stance {
  agree
  disagree
  need_discussion
}

/// A decision Samuel (or another owner) puts in front of the other
/// shareholders. Owner-only to create — this is a structured async
/// discussion tool, not a proposal system; see docs/features/
/// shareholder-decisions.md in king-domain-mobile for the full rationale.
model Decision {
  id           String         @id @default(uuid())
  title        String
  description  String
  /// Free string like "01", "02" — an optional pointer into the Marketplace
  /// Decision Ledger artifact's milestone numbering. Not a foreign key: the
  /// ledger lives in an artifact, not this database.
  milestoneRef String?
  status       DecisionStatus @default(open)
  createdById  String
  createdBy    AdminUser      @relation("DecisionsCreated", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  closedAt     DateTime?
  /// Set alongside closedAt/reopening so "who closed/reopened this, when" is
  /// visible without diffing audit logs.
  closedById   String?
  closedBy     AdminUser?     @relation("DecisionsClosed", fields: [closedById], references: [id])

  stances              DecisionStance[]
  comments             DecisionComment[]
  pendingNotifications PendingNotification[]

  @@index([status, createdAt])
  @@map("decisions")
}

/// One stance per person per decision — casting again updates it in place
/// rather than creating a new row, so the current position is always a
/// single lookup, not "most recent by createdAt".
model DecisionStance {
  id         String   @id @default(uuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  stance     Stance
  updatedAt  DateTime @updatedAt

  @@unique([decisionId, userId])
  @@map("decision_stances")
}

model DecisionComment {
  id         String   @id @default(uuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([decisionId])
  @@map("decision_comments")
}

/// Queues a comment-notification for one (decision, recipient) pair so a
/// burst of comments collapses into a single digest email rather than one
/// per comment. A scheduled job drains rows older than the delay window
/// (see src/admin/notifications.js) and deletes them once sent.
model PendingNotification {
  id             String   @id @default(uuid())
  decisionId     String
  decision       Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      AdminUser @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  commentCount   Int      @default(1)
  firstQueuedAt  DateTime @default(now())

  @@unique([decisionId, recipientId])
  @@map("pending_notifications")
}

// ── MCP admin audit trail ────────────────────────────────

/// Durable record of every tier-2/3 call made through the /api/mcp-admin/*
/// namespace (see king-domain-admin-mcp). Deliberately a database table, not
/// a local file — local-file logs are invisible to other shareholders and
/// disappear if Samuel switches machines, and these actions (creating a
/// decision on someone's behalf, revoking an admin) deserve a durable,
/// shared record.
model McpAuditLog {
  id         String   @id @default(uuid())
  tool       String
  tier       Int
  method     String
  path       String
  args       Json?
  statusCode Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("mcp_audit_logs")
}
