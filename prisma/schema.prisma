// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WaitlistRole {
  talent
  client
}

model WaitlistEntry {
  id         String       @id @default(uuid())
  email      String       @unique
  role       WaitlistRole @default(talent)
  categories String[]     @default([])
  note       String?
  joinedAt   DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("waitlist_entries")
}

// ── Admin access ─────────────────────────────────────────

enum AdminRole {
  owner // can invite and revoke other admins
  admin // read-only access to the dashboard
}

/// What an admin may do beyond reading (PRD §2, decision D43). An owner may do everything.
/// One person can hold several.
enum AdminCapability {
  reviewer    // proof verification, limited to reviewerSkills
  checker     // authenticity, identity and student documents
  safety      // reports, job-post screening
  disputes    // dispute rulings, start-proof objections
  finance     // refunds, splits, chargebacks, payout failures
  support     // shortlists, general help
  shareholder // read-only: ledger, metrics, audit log
}

enum AdminStatus {
  invited // invite issued, password not yet set
  active
  revoked
}

model AdminUser {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String?
  role         AdminRole   @default(admin)
  status       AdminStatus @default(invited)
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  capabilities   AdminCapability[] @default([])
  /// Skill keys from src/skills.js this admin may review (only with the reviewer capability).
  reviewerSkills String[]          @default([])
  auditEvents    AdminAuditEvent[]
  onCallShifts   OnCallShift[]

  tokens   AdminToken[]
  sessions AdminSession[]

  decisionsCreated     Decision[]             @relation("DecisionsCreated")
  decisionsClosed      Decision[]             @relation("DecisionsClosed")
  decisionStances      DecisionStance[]
  decisionComments     DecisionComment[]
  pendingNotifications PendingNotification[]

  @@map("admin_users")
}

enum AdminTokenKind {
  invite
  password_reset
}

/// Single-use, expiring links. Only the SHA-256 hash of the token is stored,
/// so a database leak never yields a usable link.
model AdminToken {
  id        String         @id @default(uuid())
  userId    String
  tokenHash String         @unique
  kind      AdminTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_tokens")
}

/// Refresh-token store (not a cookie session — see src/admin/jwt.js). The
/// short-lived JWT access token (15 min) is stateless and self-contained;
/// this table is what's actually revocable, and every /admin/auth/refresh
/// call re-checks revokedAt/expiresAt here before minting a new access
/// token, so revocation still takes effect within one access-token
/// lifetime even though the access token itself can't be revoked directly.
model AdminSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_sessions")
}

// ── Shareholder decisions ────────────────────────────────

enum DecisionStatus {
  open
  closed
}

enum Stance {
  agree
  disagree
  need_discussion
}

/// A decision Samuel (or another owner) puts in front of the other
/// shareholders. Owner-only to create — this is a structured async
/// discussion tool, not a proposal system; see docs/features/
/// shareholder-decisions.md in king-domain-mobile for the full rationale.
model Decision {
  id           String         @id @default(uuid())
  title        String
  description  String
  /// Free string like "01", "02" — an optional pointer into the Marketplace
  /// Decision Ledger artifact's milestone numbering. Not a foreign key: the
  /// ledger lives in an artifact, not this database.
  milestoneRef String?
  status       DecisionStatus @default(open)
  createdById  String
  createdBy    AdminUser      @relation("DecisionsCreated", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  closedAt     DateTime?
  /// Set alongside closedAt/reopening so "who closed/reopened this, when" is
  /// visible without diffing audit logs.
  closedById   String?
  closedBy     AdminUser?     @relation("DecisionsClosed", fields: [closedById], references: [id])

  stances              DecisionStance[]
  comments             DecisionComment[]
  pendingNotifications PendingNotification[]

  @@index([status, createdAt])
  @@map("decisions")
}

/// One stance per person per decision — casting again updates it in place
/// rather than creating a new row, so the current position is always a
/// single lookup, not "most recent by createdAt".
model DecisionStance {
  id         String   @id @default(uuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  stance     Stance
  updatedAt  DateTime @updatedAt

  @@unique([decisionId, userId])
  @@map("decision_stances")
}

model DecisionComment {
  id         String   @id @default(uuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([decisionId])
  @@map("decision_comments")
}

/// Queues a comment-notification for one (decision, recipient) pair so a
/// burst of comments collapses into a single digest email rather than one
/// per comment. A scheduled job drains rows older than the delay window
/// (see src/admin/notifications.js) and deletes them once sent.
model PendingNotification {
  id             String   @id @default(uuid())
  decisionId     String
  decision       Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      AdminUser @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  commentCount   Int      @default(1)
  firstQueuedAt  DateTime @default(now())

  @@unique([decisionId, recipientId])
  @@map("pending_notifications")
}

// ── MCP admin audit trail ────────────────────────────────

/// Durable record of every tier-2/3 call made through the /api/mcp-admin/*
/// namespace (see king-domain-admin-mcp). Deliberately a database table, not
/// a local file — local-file logs are invisible to other shareholders and
/// disappear if Samuel switches machines, and these actions (creating a
/// decision on someone's behalf, revoking an admin) deserve a durable,
/// shared record.
model McpAuditLog {
  id         String   @id @default(uuid())
  tool       String
  tier       Int
  method     String
  path       String
  args       Json?
  statusCode Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("mcp_audit_logs")
}

// ── Mobile app releases ──────────────────────────────────

enum AppReleaseStatus {
  draft
  published
}

/// Direct-APK distribution for internal testing (no Play Store yet — see
/// king-domain-mobile/codemagic.yaml). Pattern ported from pendu's
/// AppRelease model, including the deliberate split between
/// `forceUpdateRequested` and `forceUpdate`: a real pendu incident (2026-07-31)
/// showed that activating force-update the instant a build is uploaded can
/// lock users out before anyone has actually verified the build installs
/// correctly. `forceUpdateRequested` is just the admin's authored intent at
/// draft time; `forceUpdate` is the live flag the app actually reads, and it
/// is ONLY ever set by a separate, explicit activate-force-update call —
/// publishing a release never flips it, even if requested.
model AppRelease {
  id          String           @id @default(uuid())
  version     String           @unique
  /// Supabase Storage public/signed URL for the built APK. Null until a
  /// human uploads it (CI uploads the file; publishing sets this field).
  apkUrl      String?
  /// Structured as { highlights: string[], improvements: string[], fixes: string[] }.
  changelog   Json?
  status      AppReleaseStatus @default(draft)
  /// Single-row "pointer" — exactly one release has this true at a time,
  /// enforced in the publish route, not a DB constraint.
  isLatest    Boolean          @default(false)
  /// The live flag the app's version-check endpoint returns. See model doc.
  forceUpdate Boolean          @default(false)
  /// The admin's original intent, set at draft creation. Never touched by
  /// publish — lets the dashboard show "wants force update, not yet
  /// activated" so nothing is silently forgotten.
  forceUpdateRequested Boolean @default(false)
  minVersion  String           @default("1.0.0")
  createdAt   DateTime         @default(now())
  publishedAt DateTime?
  forceUpdateActivatedAt DateTime?

  @@index([status, isLatest])
  @@map("app_releases")
}

// ── Product domain: users, profiles, jobs, contracts ─────
//
// Sprint 1 of docs/research/BACKEND_SPRINT_PLAN.md. Mirrors the shapes
// already designed and proven out in king-domain-mobile's Flutter models
// (lib/data/models/talent_profile.dart, lib/data/models/job.dart) rather
// than inventing a new schema from scratch. Reuses WaitlistRole's
// talent/client vocabulary for User.role so the codebase has one naming
// scheme for this distinction, not two.

/// A student (talent) or a buyer (client). Auth follows the same
/// access+refresh JWT pattern as AdminUser (see src/admin/jwt.js,
/// src/user/jwt.js) rather than a new scheme — see UserSession below.
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         WaitlistRole
  fullName     String
  /// Path of the profile photo in the PUBLIC `avatars` bucket (`<userId>/<timestamp>.<ext>`), or
  /// null. The public link is derived from it, so the database never holds a link that could go stale.
  photoPath    String?
  /// Set when the person deletes their account (src/accounts.js). The row stays, anonymised, because a
  /// finished job is also a payment record. Awards, applications and new jobs refuse a user with this set.
  deletedAt    DateTime?
  /// Sprint 4: signup creates the account immediately (unverified) so the
  /// user is already logged in while they verify — matching
  /// VerifyEmailScreen's real UX (enter the code, land straight in the
  /// app), not "verify before you can even sign in."
  emailVerified            Boolean   @default(false)
  /// Only the SHA-256 hash is stored, same reasoning as AdminToken —
  /// a database leak shouldn't yield a usable code. 6 digits, not a long
  /// random token: this is read aloud/typed from an email, not a link.
  verificationCodeHash     String?
  verificationCodeExpiresAt DateTime?
  /// Forgot-password code, kept separate from the email-verification code
  /// so requesting one can't clobber the other. Hash only, 15-minute life,
  /// and dead after 5 wrong guesses — a 6-digit code is only safe because
  /// of that attempt cap.
  passwordResetCodeHash      String?
  passwordResetCodeExpiresAt DateTime?
  passwordResetAttempts      Int       @default(0)

  // ── S1: region, education line, identity (PRD §3.1, §4.4; decisions D10 to D15) ──
  /// "Nigeria" or the country, with state and city for Nigeria. Clients and talents filter by it (D23).
  country        String?
  state          String?
  city           String?
  /// Student / Graduate / Trained / Self-taught (D15): describes the person, never gates them.
  educationKind  EducationKind?
  educationSchool String?
  /// Session for a student ("2026/27"), year for a graduate ("2027"), course for trained.
  educationDetail String?
  /// Clients only: an individual or a business (checked through CAC).
  clientKind     ClientKind?
  /// What the identity check found (the name on the document), kept so payout names can be matched.
  legalName      String?
  dateOfBirth    DateTime? @db.Date
  identityVerifiedAt DateTime?
  /// An under-18 needs a guardian's confirmation (NDPA s.31; D12).
  guardianConfirmedAt DateTime?
  identityChecks   IdentityCheck[]
  guardianConsents GuardianConsent[]
  skillSubmissions SkillSubmission[]
  skillRestrictions SkillRestriction[]
  /// The last time the person used the app, moved at most every 10 minutes. "Recently active first" (D23).
  lastActiveAt DateTime @default(now())
  savedSearches SavedSearch[]

  // ── S6: where a King Domain agent can reach a person in serious escalations (D35), and removal after a lost chargeback (D36) ──
  addressLine        String?
  addressCity        String?
  addressState       String?
  addressConfirmedAt DateTime?
  removedAt          DateTime?
  removedReason      String?
  /// What money is shown in, marked "about" when it is not the job's own currency (D37).
  displayCurrency String @default("NGN")
  savedTalents  SavedTalent[] @relation("SavedByClient")
  savedBy       SavedTalent[] @relation("SavedTalent")
  invitationsSent Invitation[] @relation("InvitationsSent")
  invitationsGot  Invitation[] @relation("InvitationsGot")
  shortlistRequests ShortlistRequest[]
  conversationsAsClient Conversation[] @relation("ConversationClient")
  conversationsAsTalent Conversation[] @relation("ConversationTalent")

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions       UserSession[]
  deviceTokens   DeviceToken[]
  talentProfile  TalentProfile?
  jobsPosted     Job[]           @relation("JobsPostedByClient")
  applications   Application[]

  @@map("users")
}

/// A phone that can receive push notifications (src/push.js). `token` is the FCM registration token; it is
/// unique because one app install belongs to one person at a time: signing in as someone else on the same
/// phone moves the row. `lastSeenAt` moves on every registration, so a token nobody has refreshed for
/// 60 days can be pruned. Removed on logout, when FCM says it is dead, and on account deletion.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([lastSeenAt])
  @@map("device_tokens")
}

/// Refresh-token store for User, structurally identical to AdminSession —
/// see that model's schema comment for why a DB-backed refresh session
/// exists alongside a stateless access token.
model UserSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

/// Mirrors TalentProfile in talent_profile.dart field-for-field. One per
/// talent User — a client User never has one.
model TalentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String   @default("")
  bio             String   @default("")
  skillCategories String[] @default([])
  /// Paystack transfer recipient — created once via POST /transferrecipient
  /// after resolving the account number against the bank (GET
  /// /bank/resolve, which also returns the account holder's name for the
  /// talent to confirm before saving). recipientCode is what a real payout
  /// (POST /transfer) is addressed to; the other three fields are stored
  /// only for display ("paid out to GTBank •••1234, Jane Doe"), never used
  /// to construct a transfer request directly.
  bankAccountNumber String?
  bankCode          String?
  bankName          String?
  bankAccountName   String?
  paystackRecipientCode String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  proofItems ProofItem[]

  @@map("talent_profiles")
}

enum ProofReviewStatus {
  pending
  verified
}

/// Mirrors ProofItem in talent_profile.dart. `isVerifiedIn(category)` in
/// the Flutter model becomes: does this talent have a ProofItem in that
/// category with status verified. Verification is per-category, not
/// per-profile — see the Dart model's own comment on why (Milestone 03,
/// the anti-spam gate).
model ProofItem {
  id              String            @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile     @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  category        String
  title           String
  /// Supabase Storage PATH, not a URL — the proof-items bucket is private
  /// (personal work samples, not a public download like app-releases), so
  /// this is only ever resolved to a real, time-limited link on read via
  /// storage.js's getProofFileSignedUrl. Never expose this raw value to a
  /// client; API responses always serialize it through that function.
  filePath        String?
  status          ProofReviewStatus @default(pending)
  /// Set by whichever admin/reviewer approves or rejects the item —
  /// Sprint 2's human-review workflow. Null while pending.
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())

  @@index([talentProfileId, category])
  @@map("proof_items")
}

/// Mirrors Job in job.dart. Posted by a client User.
model Job {
  id          String   @id @default(uuid())
  clientId    String
  client      User     @relation("JobsPostedByClient", fields: [clientId], references: [id])
  title       String
  category    String
  description String
  budget      Decimal  @db.Decimal(12, 2)
  /// Days the talent has to deliver, counted from funding (1–60). The
  /// contract's deliverByAt is fixed from this when it is funded. Null on
  /// jobs posted before delivery dates existed: no deadline features.
  deliveryDays Int?
  /// Set once a client selects one Application — see Application.status
  /// and the correction doc this enforces (docs/core/
  /// correction-talent-discovery-screen.md): selecting one applicant must
  /// mark every other Application on this Job as not selected, not leave
  /// them ambiguously pending.
  awardedApplicationId String?
  /// Set when the client closes the job before awarding it. A closed job is
  /// hidden from other talents' feeds and takes no applications.
  closedAt DateTime?
  /// Bumped on every edit. An application carries the revision the talent
  /// read; a mismatch means the terms changed under them (src/jobs.js).
  revision Int @default(0)
  /// Set by every application: the "terms are locked" marker, read by the
  /// edit guard (a job with applications from before this column existed is
  /// caught by `applications: none` instead).
  lastAppliedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  contract     Contract?
  events       ContractEvent[]

  // ── S3: types, structured brief, screening, soft cap (PRD §4.1, §4.5, §4.6; D1, D17, D21, D22) ──
  /// One delivery, milestones, monthly or hourly. What `budget` means per type is in src/briefs.js.
  jobType      JobType        @default(oneDelivery)
  /// A key from src/skills.js. Null on jobs posted before skills existed (they keep `category`).
  skillKey     String?
  /// The structured brief (deliverables, quantity, formats, revisions, usage rights, client files, per-skill fields).
  brief        Json?
  /// "NGN" or "USD" (D37). Paying in dollars is built in S5.
  currency     String         @default("NGN")
  visibility   JobVisibility  @default(public)
  /// Up to three questions every applicant answers.
  screeningQuestions Json?
  /// A new client's first post is held until a person reads it (D17). Jobs from before S3 are live.
  postStatus   JobPostStatus  @default(live)
  /// What the detector found when the post was made: [{code, label, match}].
  screeningFlags Json?
  screenedById String?
  screenedAt   DateTime?
  rejectReasonCode String?
  rejectNote   String?
  /// When the job went live. The 5-day soft cap counts from here, or from `reopenedAt` (D21).
  liveAt       DateTime?
  reopenedAt   DateTime?
  invitations  Invitation[]
  /// A failed job reopens to the other applicants as a new post (D20); the old one keeps its money trail.
  reopenedFromId String?

  @@index([category])
  @@index([postStatus, liveAt])
  @@index([skillKey])
  @@map("jobs")
}

enum ApplicationStatus {
  pending
  /// The client's own shortlist (S3). Still in the running; the talent is not told.
  shortlisted
  /// The client turned it down; the talent is told (S3).
  declined
  selected
  /// Set on every other Application when the client awards the Job to one
  /// of them — see Job.awardedApplicationId.
  notSelected
}

/// Mirrors JobApplicationStatus in job.dart (notApplied/pending/accepted/
/// rejected), but modelled as its own row rather than an enum on Job,
/// since a Job now has many applicants (job.dart's mock only ever
/// tracked one talent's status against one job).
model Application {
  id        String            @id @default(uuid())
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  talentId  String
  talent    User              @relation(fields: [talentId], references: [id])
  status    ApplicationStatus @default(pending)
  createdAt DateTime          @default(now())
  /// The talent's answer to the brief (S3).
  answer    String?
  /// 1 to 3 verified pieces chosen from the profile: [{type: "submission" | "proof", id}].
  pieces    Json?
  /// Answers to the job's screening questions, in order.
  screeningAnswers Json?
  /// Set when the client declines; the talent is told at that moment.
  declinedAt DateTime?
  invitationId String?

  @@unique([jobId, talentId])
  @@index([jobId, status])
  @@map("applications")
}

enum ContractStatus {
  /// Starting state: awarded, client hasn't paid yet. Nothing can happen
  /// (no startWork) until src/contractFunding.js flips it to funded — via
  /// the webhook, the app's verify-payment call, or the fund pre-check.
  awaitingPayment
  funded
  inProgress
  submitted
  /// The client asked for changes; the talent owes a resubmit by changeDueAt.
  changesRequested
  /// Parked for an admin: round 2 still rejected, or the talent missed the
  /// resubmit clock. Stage 2 only enters it; stage 3 builds the screen that
  /// resolves it.
  disputed
  /// Ended by agreement, a ruling or a cancel-for-refund: money was split or returned. Contract.settlement says how.
  resolved
  approved
}

/// Mirrors ContractStatus in job.dart. One per Job, created at award as
/// awaitingPayment; funded once Paystack confirms the client's payment;
/// approving a submitted deliverable sends a Paystack Transfer to the
/// talent's saved recipient. Full flow: docs/core/payments.md (mobile repo).
model Contract {
  id                  String         @id @default(uuid())
  jobId               String         @unique
  job                 Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status              ContractStatus @default(awaitingPayment)
  /// The 10% platform fee, computed from Job.budget at award time and
  /// frozen here — never recalculated later even if the fee percentage
  /// changes (see the shareholder decision this implements). The client is
  /// charged budget + platformFeeAmount; only Job.budget is ever
  /// transferred out to the talent.
  platformFeeAmount   Decimal?       @db.Decimal(12, 2)
  /// Set true when verify-payment finds the latest checkout `failed`
  /// (not merely abandoned); cleared once a payment succeeds. Lets the app
  /// tell the client their last attempt failed.
  paymentFailed       Boolean        @default(false)
  /// Latest funding reference, kd_<contractId>_<hex> — generated by us and
  /// passed to POST /transaction/initialize. Overwritten on each new
  /// checkout; older references still match via the embedded contract id.
  paystackReference       String?    @unique
  /// Award timestamp + 24h: unpaid by then and the award cancels itself
  /// (src/contractLifecycle.js). Nullable for contracts made before this existed.
  payByAt                 DateTime?
  /// When the latest checkout was opened. A payment may still be in flight
  /// (bank transfer), so cancellation waits 30 min past it.
  checkoutStartedAt       DateTime?
  /// When contractFunding.js confirmed the payment with Paystack.
  fundedAt                DateTime?
  /// Paystack's transfer_code for the payout, set when the transfer is
  /// accepted (success or pending) on approval. A later transfer.failed /
  /// reversed is only logged, not recorded here — see docs/core/payments.md.
  paystackTransferCode    String?
  transferredAt           DateTime?
  deliverableNote     String?
  deliverableUrl      String?
  // Supabase Storage PATH, not a URL — deliverables bucket is private, same
  // pattern as ProofItem.filePath, resolved via getDeliverableFileSignedUrl
  // on read. Separate from deliverableUrl, which stays free text for a
  // talent who wants to paste an external link (e.g. a Drive/Figma link)
  // instead of uploading a file.
  deliverableFilePath String?
  /// Set when the talent submits. reviewDueAt = submittedAt + 3 days: the
  /// date the client is told payment auto-releases if they do nothing.
  submittedAt         DateTime?
  reviewDueAt         DateTime?
  /// Auto-release retries: a refused transfer is retried hourly up to a cap,
  /// then left for an admin.
  autoReleaseAttempts      Int       @default(0)
  lastAutoReleaseAttemptAt DateTime?
  /// fundedAt + Job.deliveryDays; granted extensions add their days.
  deliverByAt         DateTime?
  /// Extension REQUESTS made (a declined one counts). Max 2.
  extensionsUsed      Int       @default(0)
  /// Change rounds the client has opened. Max 2; after that, escalation.
  changeRounds        Int       @default(0)
  /// While changesRequested: the talent must resubmit by this or it goes to an admin.
  changeDueAt         DateTime?
  /// Set once by the tick when deliverByAt + 3 days passes with nothing delivered.
  overdueFlaggedAt    DateTime?
  /// Set while a payout is in flight (releasePayment), so a change request
  /// can't slip in between the transfer and the status update.
  releaseClaimedAt    DateTime?
  extensions          ContractExtension[]
  changeRequests      ChangeRequest[]
  deliveries          ContractDelivery[]
  reminders           ContractReminder[]

  // ── S5: start proof and the 20% release (PRD §4.2; D2, D8, D35) ──
  /// null = none yet (older jobs have none). submitted | objected | accepted | redo.
  startProofStatus      String?
  startProofSubmittedAt DateTime?
  /// The client has until this to accept or object; silence accepts (D2).
  startProofDueAt       DateTime?
  startProofAcceptedAt  DateTime?
  /// {reasonCode, note, at}: an objection is checked by a person against the checklist, not for quality (D8).
  startProofObjection   Json?
  /// How many times the proof was sent back to be redone; items belong to a round.
  startProofRound       Int       @default(0)
  /// 20% of the price, paid to the talent when the proof is accepted. Then only the rest is paid on approval.
  upfrontAmount         Decimal?  @db.Decimal(12, 2)
  upfrontClaimedAt      DateTime?
  upfrontTransferCode   String?
  upfrontPaidAt         DateTime?
  startProofItems       StartProofItem[]
  drafts                ContractDraft[]

  // ── S6: disputes, settlement, chargebacks (PRD §3.3, §4.9; D33 to D36) ──
  /// Set while a dispute is open: every clock that would pay, escalate or grant on silence waits.
  disputeHoldAt       DateTime?
  /// Money moves once: claimed first, then each leg (talent payout, client refund) records itself here and a retry resumes.
  /// {kind, trigger, talentPercent, talentAmount, clientRefund, talentTransferCode, talentPaidAt, refundId, refundStatus, refundedAt, disputeId}
  settlement          Json?
  settlementClaimedAt DateTime?
  settledAt           DateTime?
  disputes            Dispute[]
  chargebacks         Chargeback[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("contracts")
}

/// Append-only record of what happened to a job's money, kept even when the
/// Contract row is deleted (a cancelled award deletes it). contractId is plain
/// text, not a foreign key, for that reason. Evidence for disputes, and how a
/// late payment on a cancelled award is traced back to its job.
model ContractEvent {
  id         String   @id @default(uuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contractId String
  type       String
  meta       Json?
  createdAt  DateTime @default(now())
  /// Set by the push dispatcher (src/pushDispatcher.js) when it has handled this event, whether or not
  /// it had anything to send. The claim is one conditional update on this column, so an event is
  /// pushed at most once even with two dispatchers running.
  pushedAt   DateTime?

  @@index([jobId, createdAt])
  @@index([contractId])
  @@index([pushedAt, createdAt])
  @@map("contract_events")
}

enum ExtensionStatus {
  pending
  granted
  declined
  autoGranted
  /// The talent delivered while the request was still open.
  withdrawn
}

/// One extension request. Stage 2 of "How a job gets paid".
model ContractExtension {
  id            String          @id @default(uuid())
  contractId    String
  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  requestedDays Int
  reason        String
  status        ExtensionStatus @default(pending)
  requestedAt   DateTime        @default(now())
  answerDueAt   DateTime
  resolvedAt    DateTime?
  /// The client's user id; null when auto-granted or withdrawn.
  resolvedById  String?

  @@index([contractId, status])
  @@index([status, answerDueAt])
  @@map("contract_extensions")
}

/// One change round opened by the client.
model ChangeRequest {
  id            String    @id @default(uuid())
  contractId    String
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  round         Int
  reason        String
  requestedAt   DateTime  @default(now())
  resubmitDueAt DateTime
  resubmittedAt DateTime?

  @@unique([contractId, round])
  @@map("change_requests")
}

/// Every delivery, immutable. Contract.deliverable* mirror the latest one.
model ContractDelivery {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version     Int
  note        String?
  url         String?
  /// Supabase Storage path (private bucket), never a URL.
  filePath    String?
  submittedAt DateTime @default(now())

  @@unique([contractId, version])
  @@map("contract_deliveries")
}

/// A reminder that was sent. Inserted BEFORE the email so a restart or two
/// overlapping ticks can never send the same one twice.
model ContractReminder {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  key        String
  sentAt     DateTime @default(now())

  @@unique([contractId, key])
  @@map("contract_reminders")
}

/// Every action an admin takes, kept unchanged (PRD §4.11, decision D43). Never updated or deleted.
model AdminAuditEvent {
  id          String    @id @default(uuid())
  actorId     String
  actor       AdminUser @relation(fields: [actorId], references: [id])
  /// The actor's role and capabilities at the time, e.g. "admin:checker,reviewer" or "owner".
  actorRole   String
  /// Dotted verb, e.g. "proof.approve", "admin.capabilities", "oncall.create".
  action      String
  subjectType String
  subjectId   String
  reasonCode  String?
  note        String?
  details     Json?
  createdAt   DateTime  @default(now())

  @@index([subjectType, subjectId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("admin_audit_events")
}

/// A queue's promised handling time, stored as data so it can change without a deploy.
/// A queue without a row uses the default in src/admin/inbox.js.
model QueueTarget {
  queueKey        String   @id
  targetMinutes   Int
  defaultWhenLate String
  updatedAt       DateTime @updatedAt

  @@map("queue_targets")
}

/// Who is on call, and when (decision D45).
model OnCallShift {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime  @default(now())

  @@index([startsAt, endsAt])
  @@map("on_call_shifts")
}

/// An alert to the team (decision D46). Urgent ones go out at once; digest ones wait for the daily digest.
model OpsAlert {
  id         String    @id @default(uuid())
  /// "urgent" or "digest"
  severity   String
  queueKey   String
  title      String
  body       String
  link       String?
  slackSent  Boolean   @default(false)
  /// Addresses the mailer confirmed it sent to (read back, not attempted).
  emailedTo  String[]  @default([])
  digestedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([severity, digestedAt])
  @@index([queueKey, createdAt])
  @@map("ops_alerts")
}

// ── S1: identity (PRD §4.4) ───────────────────────────────

enum EducationKind {
  student
  graduate
  trained
  selfTaught
}

enum ClientKind {
  individual
  business
}

/// What the person shows: a NIN slip, a passport (international), or a CAC certificate (business).
enum IdentityDocument {
  ninSlip
  passport
  cac
}

enum IdentityCheckStatus {
  pending
  verified
  notYet
}

/// One identity submission. Until a licensed provider is live (CAC), a checker reads the document and
/// the short live video by hand (decision D47); the same row records the provider's answer later.
model IdentityCheck {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   IdentityDocument
  /// Path of the document photo in the private `identity-docs` bucket.
  documentPath String
  /// Path of the short live selfie video. Optional for a business (CAC) check.
  videoPath  String?
  /// What the person typed (so the checker compares it with the document).
  claimedName String
  claimedDateOfBirth DateTime? @db.Date
  status     IdentityCheckStatus @default(pending)
  /// Set by the checker on approval: the name and date of birth as the document shows them.
  legalName  String?
  dateOfBirth DateTime?          @db.Date
  reasonCode String?
  note       String?
  reviewedById String?
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("identity_checks")
}

/// A guardian confirming, on their own phone, that an under-18 may work (NDPA s.31; D12). The person
/// is paid into their own account regardless.
model GuardianConsent {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianName  String
  guardianEmail String
  relationship  String
  /// SHA-256 of the confirmation token in the emailed link.
  tokenHash     String    @unique
  expiresAt     DateTime
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("guardian_consents")
}

// ── S2: proving a skill (PRD §4.3; decisions D5 to D9) ────

enum SubmissionStatus {
  draft
  authenticity
  review
  verified
  notYet
  removed
}

enum SubmissionFileRole {
  output
  working
  draft
  walkthrough
}

enum SubmissionFileStatus {
  pending
  ready
}

/// One attempt to prove one skill. Never deleted: a result and its history stay visible to the person.
model SkillSubmission {
  id       String           @id @default(uuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A key from src/skills.js.
  skillKey String
  status   SubmissionStatus @default(draft)
  declaredOwnWork Boolean   @default(false)
  aiUsed   Boolean          @default(false)
  aiNote   String?
  /// Accepted before sending again after a "Not yet" (D9).
  termsAcceptedAt DateTime?
  submittedAt DateTime?

  /// The authenticity check, by a checker.
  authenticityById String?
  authenticityAt   DateTime?
  authenticityChecklist Json?
  authenticityNote String?
  /// Set by the system on submit: every finished file was in an earlier "Not yet" attempt. A checker decides.
  repeatOfRejected Boolean @default(false)

  /// {kind: "review" | "authenticity" | "removed", lines: [...], comments: [...], note}
  resultReasons Json?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieces  SubmissionPiece[]
  files   SubmissionFile[]
  reviews SubmissionReview[]

  @@index([userId, skillKey])
  @@index([status, submittedAt])
  @@map("skill_submissions")
}

model SubmissionPiece {
  id           String          @id @default(uuid())
  submissionId String
  submission   SkillSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  position     Int
  title        String          @default("")
  /// What the client asked for.
  brief        String          @default("")
  /// Their role: alone, or which part in a team.
  role         String          @default("")
  /// When it was made, as the person writes it ("March 2026").
  madeOn       String          @default("")
  liveLink     String          @default("")
  files        SubmissionFile[]

  @@index([submissionId])
  @@map("submission_pieces")
}

model SubmissionFile {
  id           String               @id @default(uuid())
  submissionId String
  submission   SkillSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  pieceId      String?
  piece        SubmissionPiece?     @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  role         SubmissionFileRole
  name         String
  contentType  String
  sizeBytes    Int
  /// Key in the private R2 bucket.
  objectKey    String               @unique
  /// R2's ETag after the upload: the file's MD5 for a single upload, used to spot unchanged resends.
  etag         String?
  status       SubmissionFileStatus @default(pending)
  createdAt    DateTime             @default(now())

  @@index([submissionId])
  @@map("submission_files")
}

/// One reviewer's scores. Two are needed, a third when they disagree. The reviewer is an AdminUser id.
model SubmissionReview {
  id           String          @id @default(uuid())
  submissionId String
  submission   SkillSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  scores       Json
  verdict      String
  comment      String          @default("")
  createdAt    DateTime        @default(now())

  @@unique([submissionId, reviewerId])
  @@map("submission_reviews")
}

/// No submissions in a skill until `until` (null = permanently): the penalty for resending rejected work
/// (2 then 3 months) or a ban for stolen work (D9).
model SkillRestriction {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillKey  String
  /// "repeat" or "ban"
  kind      String
  until     DateTime?
  reason    String
  createdById String?
  createdAt DateTime  @default(now())

  @@index([userId, skillKey])
  @@map("skill_restrictions")
}

// ── S3: jobs and discovery (PRD §4.6; D21 to D25) ────

enum JobType {
  oneDelivery
  milestones
  monthly
  hourly
}

enum JobVisibility {
  public
  invite
}

enum JobPostStatus {
  screening
  live
  rejected
}

enum InvitationStatus {
  pending
  accepted
  declined
  expired
}

/// A client asks one talent to look at a job. Up to 20 per job, each valid 72 hours (D23).
model Invitation {
  id        String           @id @default(uuid())
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  clientId  String
  client    User             @relation("InvitationsSent", fields: [clientId], references: [id], onDelete: Cascade)
  talentId  String
  talent    User             @relation("InvitationsGot", fields: [talentId], references: [id], onDelete: Cascade)
  status    InvitationStatus @default(pending)
  message   String?
  expiresAt DateTime
  respondedAt DateTime?
  createdAt DateTime         @default(now())

  @@unique([jobId, talentId])
  @@index([talentId, status])
  @@map("invitations")
}

model SavedTalent {
  id        String   @id @default(uuid())
  clientId  String
  client    User     @relation("SavedByClient", fields: [clientId], references: [id], onDelete: Cascade)
  talentId  String
  talent    User     @relation("SavedTalent", fields: [talentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, talentId])
  @@map("saved_talents")
}

/// A talent's saved job search. With `alerts` on, a matching job that goes live sends a push (free for everyone).
model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// {skillKeys, jobTypes, budgetMin, budgetMax, currency, deliveryDaysMax, query}
  filters   Json
  alerts    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("saved_searches")
}

enum ShortlistStatus {
  requested
  building
  sent
  closed
}

/// "Find someone for me" (D24). The team builds a shortlist of 3 to 5 verified talents with a line each.
model ShortlistRequest {
  id        String          @id @default(uuid())
  clientId  String
  client    User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  skillKey  String
  jobType   JobType         @default(oneDelivery)
  currency  String          @default("NGN")
  budget    Decimal         @db.Decimal(12, 2)
  brief     Json
  note      String?
  status    ShortlistStatus @default(requested)
  claimedById String?
  /// When the clock started. Outside working hours this is the next time the team starts (open item), else the request.
  clockStartedAt DateTime
  sentAt    DateTime?
  items     ShortlistItem[]
  createdAt DateTime        @default(now())

  @@index([status, createdAt])
  @@map("shortlist_requests")
}

/// One suggested talent. The talent is asked first; only those who said yes are sent (D24).
model ShortlistItem {
  id         String           @id @default(uuid())
  requestId  String
  request    ShortlistRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  talentId   String
  /// One line on why this talent fits.
  reason     String
  askedAt    DateTime?
  /// null = not answered yet, true = available, false = not available.
  available  Boolean?
  createdAt  DateTime         @default(now())

  @@unique([requestId, talentId])
  @@map("shortlist_items")
}

// ── S4: messaging (PRD §4.7; D18, D24, D27) ────

enum MessageKind {
  text
  voice
  image
  file
  /// "What we agreed": counts only once both people confirm it.
  agreement
}

enum MessageState {
  /// Delivered.
  sent
  /// Not delivered: it broke the rules for before an award (D18). Only its sender ever sees it.
  held
  /// An attachment still uploading.
  pending
}

/// One conversation per client and talent. The job's own events appear as cards between the messages.
model Conversation {
  id            String    @id @default(uuid())
  clientId      String
  client        User      @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Cascade)
  talentId      String
  talent        User      @relation("ConversationTalent", fields: [talentId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  messages      Message[]
  reads         ConversationRead[]

  @@unique([clientId, talentId])
  @@index([talentId])
  @@map("conversations")
}

/// Never deleted (D27). A text can be edited for 15 minutes; the first edit keeps the original.
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  kind           MessageKind
  state          MessageState @default(sent)
  body           String       @default("")
  /// What the detector found, for a held message: [{code, label, match}].
  heldFlags      Json?
  /// Where an attachment lives in the private bucket, and what it is.
  attachmentKey  String?      @unique
  attachmentName String?
  attachmentType String?
  attachmentBytes Int?
  durationSec    Int?
  /// The app's own id for the message, so a retry after a dropped connection never sends it twice.
  clientMsgId    String
  editedAt       DateTime?
  originalBody   String?
  agreementConfirmedByClientAt DateTime?
  agreementConfirmedByTalentAt DateTime?
  createdAt      DateTime     @default(now())
  reports        MessageReport[]

  @@unique([conversationId, senderId, clientMsgId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime

  @@id([conversationId, userId])
  @@map("conversation_reads")
}

/// A report on one message, from the other person in the conversation. Open until the team handles it.
model MessageReport {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId  String
  reasonCode  String
  note        String?
  /// open, dismissed or actioned
  status      String   @default("open")
  handledById String?
  handledAt   DateTime?
  handledNote String?
  createdAt   DateTime @default(now())

  @@unique([messageId, reporterId])
  @@index([status, createdAt])
  @@map("message_reports")
}

/// A block. Not available while a contract between the two is active (D18).
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

// ── S5: start proof, drafts ────

/// One part of a start proof: a typed answer, a link, or a file in the private bucket (never public).
model StartProofItem {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  round       Int      @default(0)
  fieldKey    String
  kind        String
  text        String?
  name        String?
  contentType String?
  sizeBytes   Int?
  objectKey   String?  @unique
  /// pending (uploading) or ready
  status      String   @default("ready")
  createdAt   DateTime @default(now())

  @@index([contractId, round])
  @@map("start_proof_items")
}

/// Work shared during the job without starting the review clock: dated, kept as evidence it was made (research: Fiverr share-draft).
model ContractDraft {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  note       String   @default("")
  /// [{name, contentType, sizeBytes, objectKey}]
  files      Json
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([contractId, createdAt])
  @@map("contract_drafts")
}

// ── S6: disputes ────

/// Something's wrong: the staircase (D33). The two sides try fixed ways out with 48-hour clocks; either can escalate,
/// silence escalates, and King Domain rules within 5 days, free, final (D34).
model Dispute {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  jobId         String
  /// null for one the system opened (change round 2 refused, resubmit clock missed).
  filedById     String?
  filedByRole   String
  problem       String
  note          String   @default("")
  /// open (finding a way out), escalated (with the team), resolved (agreed or ruled), withdrawn.
  status        String   @default("open")
  escalatedAt   DateTime?
  escalatedById String?
  /// requested, unanswered or system.
  escalationReason String?
  /// escalatedAt + 5 days.
  rulingDueAt   DateTime?
  resolvedAt    DateTime?
  /// {by: "agreement" | "ruling", kind, talentPercent}
  resolution    Json?
  /// The user who lost, when someone did (a split away from 50/50); feeds the repeat-filer flag and Proven.
  loserId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  proposals DisputeProposal[]
  ruling    DisputeRuling?

  @@index([status, rulingDueAt])
  @@index([contractId])
  @@index([filedById])
  @@map("disputes")
}

/// A fixed way out, offered by one side. 48 hours to answer; silence moves it to the team.
model DisputeProposal {
  id           String   @id @default(uuid())
  disputeId    String
  dispute      Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  proposedById String
  /// more_time, extra_revision, split, cancel or carry_on.
  kind         String
  /// more_time: {days}. split: {talentPercent}. cancel: {} (full refund of what is held).
  params       Json?
  note         String   @default("")
  /// pending, accepted, declined, expired.
  status       String   @default("pending")
  answerDueAt  DateTime
  answeredAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([disputeId, status])
  @@index([status, answerDueAt])
  @@map("dispute_proposals")
}

/// The team's decision, with written reasons shown to both sides. Above ₦100,000 a second person approves it (D44).
model DisputeRuling {
  id            String   @id @default(uuid())
  disputeId     String   @unique
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  decidedById   String
  /// release, refund or split.
  outcome       String
  talentPercent Int
  reasons       String
  talentAmount  Decimal  @db.Decimal(12, 2)
  clientRefund  Decimal  @db.Decimal(12, 2)
  /// pending_approval or final.
  status        String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())

  @@map("dispute_rulings")
}

/// A card chargeback raised by a client's bank. 16 working hours to answer or it is accepted for us (Paystack).
model Chargeback {
  id                String    @id @default(uuid())
  paystackDisputeId String    @unique
  reference         String?
  contractId        String?
  contract          Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  amountKobo        Int
  /// open, responded, won or lost.
  status            String    @default("open")
  dueAt             DateTime?
  bin               String?
  last4             String?
  customerEmail     String?
  receivedAt        DateTime  @default(now())
  respondedAt       DateTime?
  respondedById     String?
  resolution        String?
  responseNote      String?
  /// The client was removed after a lost chargeback on approved work (D36).
  clientRemovedAt   DateTime?
  raw               Json?
  updatedAt         DateTime  @updatedAt

  @@index([status, dueAt])
  @@map("chargebacks")
}

// ── S7: reviews and reputation (PRD §4.8; D29 to D32) ────

/// One person's review of the other after a job. No stars: yes / partly / no questions, a recommendation, a comment.
/// Hidden from everyone but its author until both reviews are in or 14 days have passed, then locked (D30).
model Review {
  id          String   @id @default(uuid())
  jobId       String
  contractId  String
  authorId    String
  subjectId   String
  /// client_to_talent or talent_to_client.
  direction   String
  /// client: {followedBrief, qualityAsAgreed, communicated: yes|partly|no, recommend: bool}.
  /// talent: {briefClear, feedbackClear, paidFairly: yes|partly|no, workAgain: bool}.
  answers     Json
  comment     String   @default("")
  /// The private question, seen only by King Domain: "would you work with this person again?" (D31). Never serialized to anyone else.
  privateAgain Boolean
  /// The review window closes 14 days after the job completed.
  windowEndsAt DateTime
  /// One public reply from the person reviewed.
  reply       String?
  repliedAt   DateTime?
  /// Removed only for abuse, personal data, irrelevance or leverage (never for disagreement).
  removedAt   DateTime?
  removedReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports ReviewReport[]

  @@unique([contractId, authorId])
  @@index([subjectId, createdAt])
  @@index([contractId])
  @@map("reviews")
}

/// Someone reported a review that broke the rules. A person decides (queue: reported reviews).
model ReviewReport {
  id          String   @id @default(uuid())
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId  String
  /// abuse, personal_info, unrelated or leverage.
  reasonCode  String
  note        String   @default("")
  /// open, removed or kept.
  status      String   @default("open")
  handledById String?
  handledNote String?
  handledAt   DateTime?
  createdAt   DateTime @default(now())

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
  @@map("review_reports")
}

/// A portable credential (Open Badges 3.0): a completed job, a verified skill or a Proven level. Signed as a VC-JWT
/// when the issuer key is set; otherwise it is recorded but cannot be shared yet.
model Credential {
  id         String    @id @default(uuid())
  userId     String
  /// job_completed, skill_verified or proven.
  kind       String
  skillKey   String?
  jobId      String?
  /// One credential per achievement: "job:<id>", "verified:<skill>", "proven:<skill>".
  dedupeKey  String
  title      String
  description String
  issuedAt   DateTime  @default(now())
  /// The compact JWS, once signed.
  jws        String?
  /// Proven can be lost when the signal turns bad (D32); the credential is then revoked, not deleted.
  revokedAt  DateTime?
  revokedReason String?

  @@unique([userId, dedupeKey])
  @@index([userId, issuedAt])
  @@map("credentials")
}
