// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WaitlistRole {
  talent
  client
}

model WaitlistEntry {
  id         String       @id @default(uuid())
  email      String       @unique
  role       WaitlistRole @default(talent)
  categories String[]     @default([])
  note       String?
  joinedAt   DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("waitlist_entries")
}

// ── Admin access ─────────────────────────────────────────

enum AdminRole {
  owner // can invite and revoke other admins
  admin // read-only access to the dashboard
}

enum AdminStatus {
  invited // invite issued, password not yet set
  active
  revoked
}

model AdminUser {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String?
  role         AdminRole   @default(admin)
  status       AdminStatus @default(invited)
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tokens   AdminToken[]
  sessions AdminSession[]

  decisionsCreated     Decision[]             @relation("DecisionsCreated")
  decisionsClosed      Decision[]             @relation("DecisionsClosed")
  decisionStances      DecisionStance[]
  decisionComments     DecisionComment[]
  pendingNotifications PendingNotification[]

  @@map("admin_users")
}

enum AdminTokenKind {
  invite
  password_reset
}

/// Single-use, expiring links. Only the SHA-256 hash of the token is stored,
/// so a database leak never yields a usable link.
model AdminToken {
  id        String         @id @default(uuid())
  userId    String
  tokenHash String         @unique
  kind      AdminTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_tokens")
}

/// Refresh-token store (not a cookie session — see src/admin/jwt.js). The
/// short-lived JWT access token (15 min) is stateless and self-contained;
/// this table is what's actually revocable, and every /admin/auth/refresh
/// call re-checks revokedAt/expiresAt here before minting a new access
/// token, so revocation still takes effect within one access-token
/// lifetime even though the access token itself can't be revoked directly.
model AdminSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_sessions")
}

// ── Shareholder decisions ────────────────────────────────

enum DecisionStatus {
  open
  closed
}

enum Stance {
  agree
  disagree
  need_discussion
}

/// A decision Samuel (or another owner) puts in front of the other
/// shareholders. Owner-only to create — this is a structured async
/// discussion tool, not a proposal system; see docs/features/
/// shareholder-decisions.md in king-domain-mobile for the full rationale.
model Decision {
  id           String         @id @default(uuid())
  title        String
  description  String
  /// Free string like "01", "02" — an optional pointer into the Marketplace
  /// Decision Ledger artifact's milestone numbering. Not a foreign key: the
  /// ledger lives in an artifact, not this database.
  milestoneRef String?
  status       DecisionStatus @default(open)
  createdById  String
  createdBy    AdminUser      @relation("DecisionsCreated", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  closedAt     DateTime?
  /// Set alongside closedAt/reopening so "who closed/reopened this, when" is
  /// visible without diffing audit logs.
  closedById   String?
  closedBy     AdminUser?     @relation("DecisionsClosed", fields: [closedById], references: [id])

  stances              DecisionStance[]
  comments             DecisionComment[]
  pendingNotifications PendingNotification[]

  @@index([status, createdAt])
  @@map("decisions")
}

/// One stance per person per decision — casting again updates it in place
/// rather than creating a new row, so the current position is always a
/// single lookup, not "most recent by createdAt".
model DecisionStance {
  id         String   @id @default(uuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  stance     Stance
  updatedAt  DateTime @updatedAt

  @@unique([decisionId, userId])
  @@map("decision_stances")
}

model DecisionComment {
  id         String   @id @default(uuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([decisionId])
  @@map("decision_comments")
}

/// Queues a comment-notification for one (decision, recipient) pair so a
/// burst of comments collapses into a single digest email rather than one
/// per comment. A scheduled job drains rows older than the delay window
/// (see src/admin/notifications.js) and deletes them once sent.
model PendingNotification {
  id             String   @id @default(uuid())
  decisionId     String
  decision       Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      AdminUser @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  commentCount   Int      @default(1)
  firstQueuedAt  DateTime @default(now())

  @@unique([decisionId, recipientId])
  @@map("pending_notifications")
}

// ── MCP admin audit trail ────────────────────────────────

/// Durable record of every tier-2/3 call made through the /api/mcp-admin/*
/// namespace (see king-domain-admin-mcp). Deliberately a database table, not
/// a local file — local-file logs are invisible to other shareholders and
/// disappear if Samuel switches machines, and these actions (creating a
/// decision on someone's behalf, revoking an admin) deserve a durable,
/// shared record.
model McpAuditLog {
  id         String   @id @default(uuid())
  tool       String
  tier       Int
  method     String
  path       String
  args       Json?
  statusCode Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("mcp_audit_logs")
}

// ── Mobile app releases ──────────────────────────────────

enum AppReleaseStatus {
  draft
  published
}

/// Direct-APK distribution for internal testing (no Play Store yet — see
/// king-domain-mobile/codemagic.yaml). Pattern ported from pendu's
/// AppRelease model, including the deliberate split between
/// `forceUpdateRequested` and `forceUpdate`: a real pendu incident (2026-07-31)
/// showed that activating force-update the instant a build is uploaded can
/// lock users out before anyone has actually verified the build installs
/// correctly. `forceUpdateRequested` is just the admin's authored intent at
/// draft time; `forceUpdate` is the live flag the app actually reads, and it
/// is ONLY ever set by a separate, explicit activate-force-update call —
/// publishing a release never flips it, even if requested.
model AppRelease {
  id          String           @id @default(uuid())
  version     String           @unique
  /// Supabase Storage public/signed URL for the built APK. Null until a
  /// human uploads it (CI uploads the file; publishing sets this field).
  apkUrl      String?
  /// Structured as { highlights: string[], improvements: string[], fixes: string[] }.
  changelog   Json?
  status      AppReleaseStatus @default(draft)
  /// Single-row "pointer" — exactly one release has this true at a time,
  /// enforced in the publish route, not a DB constraint.
  isLatest    Boolean          @default(false)
  /// The live flag the app's version-check endpoint returns. See model doc.
  forceUpdate Boolean          @default(false)
  /// The admin's original intent, set at draft creation. Never touched by
  /// publish — lets the dashboard show "wants force update, not yet
  /// activated" so nothing is silently forgotten.
  forceUpdateRequested Boolean @default(false)
  minVersion  String           @default("1.0.0")
  createdAt   DateTime         @default(now())
  publishedAt DateTime?
  forceUpdateActivatedAt DateTime?

  @@index([status, isLatest])
  @@map("app_releases")
}

// ── Product domain: users, profiles, jobs, contracts ─────
//
// Sprint 1 of docs/research/BACKEND_SPRINT_PLAN.md. Mirrors the shapes
// already designed and proven out in king-domain-mobile's Flutter models
// (lib/data/models/talent_profile.dart, lib/data/models/job.dart) rather
// than inventing a new schema from scratch. Reuses WaitlistRole's
// talent/client vocabulary for User.role so the codebase has one naming
// scheme for this distinction, not two.

/// A student (talent) or a buyer (client). Auth follows the same
/// access+refresh JWT pattern as AdminUser (see src/admin/jwt.js,
/// src/user/jwt.js) rather than a new scheme — see UserSession below.
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         WaitlistRole
  fullName     String
  /// Sprint 4: signup creates the account immediately (unverified) so the
  /// user is already logged in while they verify — matching
  /// VerifyEmailScreen's real UX (enter the code, land straight in the
  /// app), not "verify before you can even sign in."
  emailVerified            Boolean   @default(false)
  /// Only the SHA-256 hash is stored, same reasoning as AdminToken —
  /// a database leak shouldn't yield a usable code. 6 digits, not a long
  /// random token: this is read aloud/typed from an email, not a link.
  verificationCodeHash     String?
  verificationCodeExpiresAt DateTime?
  /// Forgot-password code, kept separate from the email-verification code
  /// so requesting one can't clobber the other. Hash only, 15-minute life,
  /// and dead after 5 wrong guesses — a 6-digit code is only safe because
  /// of that attempt cap.
  passwordResetCodeHash      String?
  passwordResetCodeExpiresAt DateTime?
  passwordResetAttempts      Int       @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions       UserSession[]
  talentProfile  TalentProfile?
  jobsPosted     Job[]           @relation("JobsPostedByClient")
  applications   Application[]

  @@map("users")
}

/// Refresh-token store for User, structurally identical to AdminSession —
/// see that model's schema comment for why a DB-backed refresh session
/// exists alongside a stateless access token.
model UserSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

/// Mirrors TalentProfile in talent_profile.dart field-for-field. One per
/// talent User — a client User never has one.
model TalentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String   @default("")
  bio             String   @default("")
  skillCategories String[] @default([])
  /// Paystack transfer recipient — created once via POST /transferrecipient
  /// after resolving the account number against the bank (GET
  /// /bank/resolve, which also returns the account holder's name for the
  /// talent to confirm before saving). recipientCode is what a real payout
  /// (POST /transfer) is addressed to; the other three fields are stored
  /// only for display ("paid out to GTBank •••1234, Jane Doe"), never used
  /// to construct a transfer request directly.
  bankAccountNumber String?
  bankCode          String?
  bankName          String?
  bankAccountName   String?
  paystackRecipientCode String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  proofItems ProofItem[]

  @@map("talent_profiles")
}

enum ProofReviewStatus {
  pending
  verified
}

/// Mirrors ProofItem in talent_profile.dart. `isVerifiedIn(category)` in
/// the Flutter model becomes: does this talent have a ProofItem in that
/// category with status verified. Verification is per-category, not
/// per-profile — see the Dart model's own comment on why (Milestone 03,
/// the anti-spam gate).
model ProofItem {
  id              String            @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile     @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  category        String
  title           String
  /// Supabase Storage PATH, not a URL — the proof-items bucket is private
  /// (personal work samples, not a public download like app-releases), so
  /// this is only ever resolved to a real, time-limited link on read via
  /// storage.js's getProofFileSignedUrl. Never expose this raw value to a
  /// client; API responses always serialize it through that function.
  filePath        String?
  status          ProofReviewStatus @default(pending)
  /// Set by whichever admin/reviewer approves or rejects the item —
  /// Sprint 2's human-review workflow. Null while pending.
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())

  @@index([talentProfileId, category])
  @@map("proof_items")
}

/// Mirrors Job in job.dart. Posted by a client User.
model Job {
  id          String   @id @default(uuid())
  clientId    String
  client      User     @relation("JobsPostedByClient", fields: [clientId], references: [id])
  title       String
  category    String
  description String
  budget      Decimal  @db.Decimal(12, 2)
  /// Days the talent has to deliver, counted from funding (1–60). The
  /// contract's deliverByAt is fixed from this when it is funded. Null on
  /// jobs posted before delivery dates existed: no deadline features.
  deliveryDays Int?
  /// Set once a client selects one Application — see Application.status
  /// and the correction doc this enforces (docs/core/
  /// correction-talent-discovery-screen.md): selecting one applicant must
  /// mark every other Application on this Job as not selected, not leave
  /// them ambiguously pending.
  awardedApplicationId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  contract     Contract?
  events       ContractEvent[]

  @@index([category])
  @@map("jobs")
}

enum ApplicationStatus {
  pending
  selected
  /// Set on every other Application when the client awards the Job to one
  /// of them — see Job.awardedApplicationId.
  notSelected
}

/// Mirrors JobApplicationStatus in job.dart (notApplied/pending/accepted/
/// rejected), but modelled as its own row rather than an enum on Job,
/// since a Job now has many applicants (job.dart's mock only ever
/// tracked one talent's status against one job).
model Application {
  id        String            @id @default(uuid())
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  talentId  String
  talent    User              @relation(fields: [talentId], references: [id])
  status    ApplicationStatus @default(pending)
  createdAt DateTime          @default(now())

  @@unique([jobId, talentId])
  @@index([jobId, status])
  @@map("applications")
}

enum ContractStatus {
  /// Starting state: awarded, client hasn't paid yet. Nothing can happen
  /// (no startWork) until src/contractFunding.js flips it to funded — via
  /// the webhook, the app's verify-payment call, or the fund pre-check.
  awaitingPayment
  funded
  inProgress
  submitted
  /// The client asked for changes; the talent owes a resubmit by changeDueAt.
  changesRequested
  /// Parked for an admin: round 2 still rejected, or the talent missed the
  /// resubmit clock. Stage 2 only enters it; stage 3 builds the screen that
  /// resolves it.
  disputed
  approved
}

/// Mirrors ContractStatus in job.dart. One per Job, created at award as
/// awaitingPayment; funded once Paystack confirms the client's payment;
/// approving a submitted deliverable sends a Paystack Transfer to the
/// talent's saved recipient. Full flow: docs/core/payments.md (mobile repo).
model Contract {
  id                  String         @id @default(uuid())
  jobId               String         @unique
  job                 Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status              ContractStatus @default(awaitingPayment)
  /// The 10% platform fee, computed from Job.budget at award time and
  /// frozen here — never recalculated later even if the fee percentage
  /// changes (see the shareholder decision this implements). The client is
  /// charged budget + platformFeeAmount; only Job.budget is ever
  /// transferred out to the talent.
  platformFeeAmount   Decimal?       @db.Decimal(12, 2)
  /// Set true when verify-payment finds the latest checkout `failed`
  /// (not merely abandoned); cleared once a payment succeeds. Lets the app
  /// tell the client their last attempt failed.
  paymentFailed       Boolean        @default(false)
  /// Latest funding reference, kd_<contractId>_<hex> — generated by us and
  /// passed to POST /transaction/initialize. Overwritten on each new
  /// checkout; older references still match via the embedded contract id.
  paystackReference       String?    @unique
  /// Award timestamp + 24h: unpaid by then and the award cancels itself
  /// (src/contractLifecycle.js). Nullable for contracts made before this existed.
  payByAt                 DateTime?
  /// When the latest checkout was opened. A payment may still be in flight
  /// (bank transfer), so cancellation waits 30 min past it.
  checkoutStartedAt       DateTime?
  /// When contractFunding.js confirmed the payment with Paystack.
  fundedAt                DateTime?
  /// Paystack's transfer_code for the payout, set when the transfer is
  /// accepted (success or pending) on approval. A later transfer.failed /
  /// reversed is only logged, not recorded here — see docs/core/payments.md.
  paystackTransferCode    String?
  transferredAt           DateTime?
  deliverableNote     String?
  deliverableUrl      String?
  // Supabase Storage PATH, not a URL — deliverables bucket is private, same
  // pattern as ProofItem.filePath, resolved via getDeliverableFileSignedUrl
  // on read. Separate from deliverableUrl, which stays free text for a
  // talent who wants to paste an external link (e.g. a Drive/Figma link)
  // instead of uploading a file.
  deliverableFilePath String?
  /// Set when the talent submits. reviewDueAt = submittedAt + 3 days: the
  /// date the client is told payment auto-releases if they do nothing.
  submittedAt         DateTime?
  reviewDueAt         DateTime?
  /// Auto-release retries: a refused transfer is retried hourly up to a cap,
  /// then left for an admin.
  autoReleaseAttempts      Int       @default(0)
  lastAutoReleaseAttemptAt DateTime?
  /// fundedAt + Job.deliveryDays; granted extensions add their days.
  deliverByAt         DateTime?
  /// Extension REQUESTS made (a declined one counts). Max 2.
  extensionsUsed      Int       @default(0)
  /// Change rounds the client has opened. Max 2; after that, escalation.
  changeRounds        Int       @default(0)
  /// While changesRequested: the talent must resubmit by this or it goes to an admin.
  changeDueAt         DateTime?
  /// Set once by the tick when deliverByAt + 3 days passes with nothing delivered.
  overdueFlaggedAt    DateTime?
  /// Set while a payout is in flight (releasePayment), so a change request
  /// can't slip in between the transfer and the status update.
  releaseClaimedAt    DateTime?
  extensions          ContractExtension[]
  changeRequests      ChangeRequest[]
  deliveries          ContractDelivery[]
  reminders           ContractReminder[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("contracts")
}

/// Append-only record of what happened to a job's money, kept even when the
/// Contract row is deleted (a cancelled award deletes it). contractId is plain
/// text, not a foreign key, for that reason. Evidence for disputes, and how a
/// late payment on a cancelled award is traced back to its job.
model ContractEvent {
  id         String   @id @default(uuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contractId String
  type       String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([contractId])
  @@map("contract_events")
}

enum ExtensionStatus {
  pending
  granted
  declined
  autoGranted
  /// The talent delivered while the request was still open.
  withdrawn
}

/// One extension request. Stage 2 of "How a job gets paid".
model ContractExtension {
  id            String          @id @default(uuid())
  contractId    String
  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  requestedDays Int
  reason        String
  status        ExtensionStatus @default(pending)
  requestedAt   DateTime        @default(now())
  answerDueAt   DateTime
  resolvedAt    DateTime?
  /// The client's user id; null when auto-granted or withdrawn.
  resolvedById  String?

  @@index([contractId, status])
  @@index([status, answerDueAt])
  @@map("contract_extensions")
}

/// One change round opened by the client.
model ChangeRequest {
  id            String    @id @default(uuid())
  contractId    String
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  round         Int
  reason        String
  requestedAt   DateTime  @default(now())
  resubmitDueAt DateTime
  resubmittedAt DateTime?

  @@unique([contractId, round])
  @@map("change_requests")
}

/// Every delivery, immutable. Contract.deliverable* mirror the latest one.
model ContractDelivery {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version     Int
  note        String?
  url         String?
  /// Supabase Storage path (private bucket), never a URL.
  filePath    String?
  submittedAt DateTime @default(now())

  @@unique([contractId, version])
  @@map("contract_deliveries")
}

/// A reminder that was sent. Inserted BEFORE the email so a restart or two
/// overlapping ticks can never send the same one twice.
model ContractReminder {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  key        String
  sentAt     DateTime @default(now())

  @@unique([contractId, key])
  @@map("contract_reminders")
}
