# Pooled (transaction-mode, IPv4-only) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (session-mode) — used by Prisma for migrations (see scripts/db-push.js).
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

PORT=4000

# Comma-separated. Must include the admin app's origin as well as the site's.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180

# Where invite links point. The admin app's base URL.
ADMIN_APP_URL=http://localhost:5180

# Set to "true" when the admin app is on a different site to the API, so the
# session cookie is issued with SameSite=None. Requires HTTPS.
ADMIN_COOKIE_CROSS_SITE=false

# Optional — Sentry error tracking. Errors are silently not reported if unset.
SENTRY_DSN=
NODE_ENV=production
