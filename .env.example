# Pooled (transaction-mode, IPv4-only) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (session-mode) — used by Prisma for migrations (see scripts/db-push.js).
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

PORT=4000

# Comma-separated. Must include the admin app's origin as well as the site's.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180

# Where invite links point. The admin app's base URL.
ADMIN_APP_URL=http://localhost:5180

# Set to "true" when the admin app is on a different site to the API, so the
# session cookie is issued with SameSite=None. Requires HTTPS.
ADMIN_COOKIE_CROSS_SITE=false

# Optional — Sentry error tracking. Errors are silently not reported if unset.
SENTRY_DSN=
NODE_ENV=production

# Optional — Brevo HTTP API for invite/reset emails. Without it, links are
# only logged server-side rather than sent.
#
# IMPORTANT: do not use SMTP (Gmail or otherwise) for this on Render's free
# tier — it blocks all outbound traffic on SMTP ports (25/465/587) at the
# network level, confirmed via Render's own changelog. No client-side fix
# works around it. Brevo's API runs over plain HTTPS, which isn't blocked.
# Sign up at brevo.com — free tier sends to any address, no domain to verify.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Bearer token for the isolated /api/mcp-admin/* namespace (king-domain-admin-mcp).
# Fails closed (503) on every request in this namespace if unset.
MCP_ADMIN_API_TOKEN=

# Supabase Storage — hosts built APKs for direct-install distribution (no
# Play Store yet). SUPABASE_URL is the same project as DATABASE_URL above.
# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard > Settings > API >
# service_role key (secret — bypasses RLS, server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token Codemagic uses to fetch the pending draft release and upload
# the built APK. Must match the value set as a Codemagic environment variable.
CI_API_TOKEN=
